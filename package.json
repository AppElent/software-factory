{
	"name": "software-factory",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env.local src/server/main.ts & vite",
		"dev:web": "vite",
		"start": "node src/server/main.ts",
		"demo": "SF_DEMO=1 SF_DATA_DIR=.scratch/demo SF_PORT=4311 node src/server/main.ts",
		"build": "vite build",
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "node tests/e2e/run.mjs",
		"service:install": "node scripts/service.mjs install",
		"service:uninstall": "node scripts/service.mjs uninstall"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.0",
		"@fontsource/ibm-plex-sans": "^5.2.0",
		"@hono/node-server": "^1.19.0",
		"@tanstack/react-query": "^5.100.0",
		"@tanstack/react-router": "^1.170.0",
		"cmdk": "1.1.1",
		"hono": "^4.13.0",
		"radix-ui": "^1.8.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"zod": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"jsdom": "^27.0.0",
		"playwright-core": "^1.50.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.9"
	}
}
